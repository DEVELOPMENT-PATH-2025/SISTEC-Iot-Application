rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Readings collection
    match /readings/{readingId} {
      // Allow list and get for signed in users (Dashboard view)
      allow read: if isSignedIn();

      // Allow creating readings. 
      // Note: Since sensor data comes via an Express API proxy, 
      // the server is acting as a client. 
      // We validate the data shape strictly.
      allow create: if 
        incoming().temperature is number &&
        incoming().humidity is number &&
        incoming().timestamp is timestamp;

      // Allow delete for signed in users (Dashboard action)
      allow delete: if isSignedIn();
      
      // Updates are not allowed for sensor history
      allow update: if false;
    }

    // Users collection
    match /users/{userId} {
      // Users can only read and write their own profile
      allow read, write: if isOwner(userId);
    }

    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
